{
  "name": "@kinetix/cli",
  "version": "0.0.1",
  "description": "Command-line interface for Kinetix.run",
  "bin": {
    "kinetix": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup && chmod +x dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start": "./dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@kinetix/shared": "workspace:*",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.1",
    "inquirer": "^12.0.0",
    "table": "^6.8.2",
    "conf": "^12.0.0",
    "open": "^10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.11.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}